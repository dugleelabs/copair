{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://copair.dev/schemas/headless-result.schema.json",
  "title": "Copair headless result document",
  "description": "The single JSON document copair --headless writes to stdout at exit. Result schema version 1.",
  "x-schema-version": 1,
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "run": {
      "type": "object",
      "properties": {
        "task_source": {
          "type": "string",
          "enum": [
            "arg",
            "file",
            "stdin"
          ]
        },
        "cwd": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "task_source",
        "cwd",
        "started_at",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "termination_reason": {
      "type": "string",
      "enum": [
        "completed",
        "model-declared-done",
        "approval-required",
        "context-exhausted",
        "max-tool-calls",
        "max-tokens",
        "aborted",
        "error"
      ]
    },
    "turns": {
      "type": "object",
      "properties": {
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assistant_messages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "tool_calls",
        "assistant_messages"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "estimated_cost_usd"
      ],
      "additionalProperties": false
    },
    "resolved_config": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "tier": {
          "type": "string",
          "enum": [
            "small",
            "large",
            "unknown"
          ]
        },
        "formatter": {
          "type": "string",
          "enum": [
            "dsml",
            "qwen-xml",
            "fenced-block",
            "native"
          ]
        },
        "toggles": {
          "type": "object",
          "properties": {
            "loop_guard": {
              "type": "boolean"
            },
            "format_repair": {
              "type": "boolean"
            },
            "inspect_before_act": {
              "type": "boolean"
            },
            "truncation": {
              "type": "boolean"
            }
          },
          "required": [
            "loop_guard",
            "format_repair",
            "inspect_before_act",
            "truncation"
          ],
          "additionalProperties": false
        },
        "permissions": {
          "type": "string",
          "enum": [
            "headless-terminate",
            "headless-auto-approve"
          ]
        },
        "limits": {
          "type": "object",
          "properties": {
            "max_tool_calls": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_tokens": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "max_tool_calls",
            "max_tokens"
          ],
          "additionalProperties": false
        },
        "config_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "model",
        "provider",
        "tier",
        "formatter",
        "toggles",
        "permissions",
        "limits",
        "config_sources"
      ],
      "additionalProperties": false
    },
    "events_file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "run",
    "termination_reason",
    "turns",
    "usage",
    "resolved_config",
    "events_file",
    "session_id",
    "error"
  ],
  "additionalProperties": false
}
